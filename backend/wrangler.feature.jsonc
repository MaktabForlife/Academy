{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "feature_worker",
  "account_id": "c9a3e355b3d7a795880b1d36a1dbe123",
  "main": "src/academy-development-runtime.js",
  "compatibility_date": "2026-10-23",
  "workers_dev": true,
  "preview_urls": false,
  "keep_vars": false,
  "d1_databases": [
    {
      "binding": "ACADEMY_DB",
      "database_name": "feature-academy-core",
      "database_id": "0eaf6d46-bbaa-46e3-8287-b6113ef8f2a8"
    },
    {
      "binding": "ACADEMY_ADMIN_DB",
      "database_name": "feature-academy-admin",
      "database_id": "18ad0efb-cd34-42a4-b510-7051f0303200"
    }
  ],
  "r2_buckets": [
    {
      "binding": "LESSON_MEDIA_BUCKET",
      "bucket_name": "maktab-lesson-media-private-feature"
    },
    {
      "binding": "ASSESSMENT_BUCKET",
      "bucket_name": "maktab-assessments-private-feature"
    },
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "maktab-feature-media-private"
    }
  ],
  "ratelimits": [
    {
      "name": "AUTH_LOGIN_RATE_LIMITER",
      "namespace_id": "100111",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "PROGRAM_TIMETABLE_COORDINATOR",
        "class_name": "ProgramTimetableCoordinator"
      },
      {
        "name": "ACADEMY_SPLIT_COORDINATOR",
        "class_name": "AcademySplitCoordinator",
        "script_name": "academy_feature_split_coordinator"
      }
    ]
  },
  "triggers": {
    "crons": []
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "ACADEMY_D1_MODE": "PAUSED",
    "ACADEMY_LIBRARY_MODE": "PUBLIC_ONLY",
    "ENVIRONMENT": "feature",
    "ALLOWED_ORIGINS": "https://feature-preview.academy-maktab4life.pages.dev",
    "API_ORIGIN": "https://feature_worker.maktab4life.workers.dev",
    "ACADEMY_OBJECT_NAMESPACE": "feature-isolated-v1/",
    "ACADEMY_D1_RUN_ID": "FEATURE_NOT_INITIALISED",
    "ACADEMY_DB_GENERATION": "SPLIT_V1",
    "ACADEMY_DEPLOYMENT_KIND": "ISOLATED_PREVIEW",
    "ACADEMY_ACCEPTED_SETUP": "1",
    "ACADEMY_LEARNING_OPERATIONS": "3",
    "ACADEMY_MEDIA_SEPARATION": "1",
    "ACADEMY_NOTE_RETENTION": "1",
    "ACADEMY_MESSAGING": "1",
    "ACADEMY_WEEKLY_ABSENTEES": "1",
    "ACADEMY_MONTHLY_SUBSCRIPTIONS": "1",
    "ACADEMY_SURAH_GRANTS": "1",
    "ACADEMY_WEB_PLATFORM": "0",
    "ACADEMY_WEBSITE_STUDIO": "0",
    "HIFZ_HANDOFF_ENABLED": "0",
    "HIFZ_PROFILE_SYNC_URL": "",
    "HIFZ_DEVELOPMENT_HANDOFF_URL": ""
  },
  "secrets": {
    "required": [
      "PIN_SECRET",
      "SESSION_SECRET",
      "SHARED_PIN_SECRET",
      "ACADEMY_OPEN_LIBRARY_STORAGE_KEY"
    ]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "migrations": [
    {
      "tag": "feature-isolated-v1",
      "new_sqlite_classes": [
        "ProgramTimetableCoordinator"
      ]
    }
  ]
}
