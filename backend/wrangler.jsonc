{
  "name": "devrebootworker",
  "main": "src/academy-worker-runtime.js",
  "compatibility_date": "2026-10-14",
  "keep_vars": true,
  "r2_buckets": [
    {
      "binding": "LESSON_MEDIA_BUCKET",
      "bucket_name": "maktab-lesson-media-private-development"
    },
    {
      "binding": "ASSESSMENT_BUCKET",
      "bucket_name": "maktab-assessments-private-development"
    },
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "maktab4lifemedia"
    }
  ],
  "env": {
    "development": {
      "name": "devrebootworker",
      "account_id": "c9a3e355b3d7a795880b1d36a1dbe123",
      "main": "src/academy-worker-runtime.js",
      "compatibility_date": "2026-10-14",
      "triggers": {
        "crons": [
          "*/15 * * * *"
        ]
      },
      "d1_databases": [
        {
          "binding": "ACADEMY_DB",
          "database_name": "maktab-academy",
          "database_id": "7e732b79-a72f-4da6-be83-524919c49ba4",
          "migrations_dir": "migrations/academy"
        }
      ],
      "observability": {
        "enabled": true,
        "head_sampling_rate": 1
      },
      "r2_buckets": [
        {
          "binding": "LESSON_MEDIA_BUCKET",
          "bucket_name": "maktab-lesson-media-private-development"
        },
        {
          "binding": "ASSESSMENT_BUCKET",
          "bucket_name": "maktab-assessments-private-development"
        },
        {
          "binding": "MEDIA_BUCKET",
          "bucket_name": "maktab4lifemedia"
        }
      ],
      "ratelimits": [
        {
          "name": "AUTH_LOGIN_RATE_LIMITER",
          "namespace_id": "100101",
          "simple": {
            "limit": 5,
            "period": 60
          }
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "PROGRAM_TIMETABLE_COORDINATOR",
            "class_name": "ProgramTimetableCoordinator"
          }
        ]
      },
      "vars": {
        "HIFZ_PROFILE_SYNC_URL": "https://hifzhelper-api.hifzhelper-app.workers.dev/internal/academy/profile-sync",
        "HIFZ_PROFILE_SYNC_TARGET": "production",
        "HIFZ_HANDOFF_ENABLED": "1",
        "HIFZ_DEVELOPMENT_HANDOFF_URL": "https://hifzhelper-api-dev.hifzhelper-app.workers.dev/internal/academy/profile-sync"
      }
    }
  },
  "ratelimits": [
    {
      "name": "AUTH_LOGIN_RATE_LIMITER",
      "namespace_id": "100101",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "PROGRAM_TIMETABLE_COORDINATOR",
        "class_name": "ProgramTimetableCoordinator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1052-program-timetable",
      "new_sqlite_classes": [
        "ProgramTimetableCoordinator"
      ]
    }
  ],
  "account_id": "c9a3e355b3d7a795880b1d36a1dbe123",
  "triggers": {
    "crons": [
      "*/15 * * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "ACADEMY_DB",
      "database_name": "maktab-academy",
      "database_id": "7e732b79-a72f-4da6-be83-524919c49ba4",
      "migrations_dir": "migrations/academy"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "HIFZ_PROFILE_SYNC_URL": "https://hifzhelper-api.hifzhelper-app.workers.dev/internal/academy/profile-sync",
    "HIFZ_PROFILE_SYNC_TARGET": "production",
        "HIFZ_HANDOFF_ENABLED": "1",
        "HIFZ_DEVELOPMENT_HANDOFF_URL": "https://hifzhelper-api-dev.hifzhelper-app.workers.dev/internal/academy/profile-sync"
  }
}
