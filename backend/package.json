    "test:memorisation": "node --test tests/academy-d1-memorisation.test.mjs",
    "test:memorisation:browser": "node tools/academy-memorisation-acceptance.mjs",
    "test:academy": "node tests/run-group.mjs academy",
    "test:offline": "node tests/run-group.mjs offline",
    "check:academy-boundary": "node tools/academy-boundary.mjs",
    "test:pdf-bookmarks:browser": "node tools/academy-pdf-bookmarks-acceptance.mjs",
    "deploy:feature": "wrangler deploy --config wrangler.feature.jsonc --keep-vars"
