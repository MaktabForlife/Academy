{
  "name": "maktab-academy-development",
  "version": "107.90",
  "type": "module",
  "scripts": {
    "test": "node tests/run-all.mjs",
    "test:messaging": "node --test tests/academy-messaging.test.mjs",
    "test:messaging:browser": "node tools/academy-messaging-acceptance.mjs",
    "preview:messaging": "node tools/academy-messaging-preview.mjs",
    "test:academy-mobile": "node tools/academy-mobile-layout-acceptance.mjs",
    "test:lesson-media": "node --test tests/academy-lesson-media.test.mjs tests/academy-session-media.test.mjs",
    "test:lesson-media:browser": "node tools/academy-lesson-media-acceptance.mjs && node tools/academy-session-media-acceptance.mjs",
    "test:assessments": "node --test tests/academy-d1-assessments.test.mjs tests/academy-d1-assessment-register.test.mjs",
    "test:assessments:browser": "node tools/academy-assessment-acceptance.mjs",
    "test:assessments:r2": "node tools/academy-assessment-r2-smoke.mjs",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --env development --keep-vars",
