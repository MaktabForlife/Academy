{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "academy_split_coordinator",
  "account_id": "c9a3e355b3d7a795880b1d36a1dbe123",
  "main": "src/academy-split-coordinator.js",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "ACADEMY_DB",
      "database_name": "dev-academy-core",
      "database_id": "1c8aece3-dc1d-40d1-8a82-01ab4f63336f"
    },
    {
      "binding": "ACADEMY_ADMIN_DB",
      "database_name": "dev-academy-admin",
      "database_id": "fe85dac1-b1f0-4079-9127-2e36089aa385"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ACADEMY_SPLIT_COORDINATOR",
        "class_name": "AcademySplitCoordinator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "split-v1",
      "new_sqlite_classes": [
        "AcademySplitCoordinator"
      ]
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
