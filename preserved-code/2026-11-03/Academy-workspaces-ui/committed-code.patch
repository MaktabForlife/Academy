+});
+function endDrag(){if(!drag)return;const moved=drag.moved;drag.block.classList.remove('preview-block-dragging');suppressClick=moved?drag.block:null;drag=null;if(moved){save();setTimeout(()=>{suppressClick=null;},0);}}
