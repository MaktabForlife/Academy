+++ b/backend/tests/academy-workspace-library-preview.test.mjs
@@ -0,0 +1,23 @@
+import {test} from 'node:test';
+import assert from 'node:assert/strict';
+import {libraryPreviewResponse,sampleLibraryBooks,samplePdfPath} from '../tools/workspace-ui-preview/library.mjs';
+
+test('offline catalogue opens only its synthetic document through the existing reader validation',async()=>{
+ const {publicPdfFile}=await import('../../js/m4l-pdf-bookmarks-model.mjs');
+ const catalogue=libraryPreviewResponse('/academy/open-library/catalogue');
+ assert.deepEqual((await catalogue.json()).books,sampleLibraryBooks);
+ assert.equal(publicPdfFile(samplePdfPath),samplePdfPath);
+ const document=libraryPreviewResponse(samplePdfPath),bytes=Buffer.from(await document.arrayBuffer());
+ assert.equal(document.headers.get('Content-Type'),'application/pdf');
+ assert.match(bytes.toString(),/^%PDF-1.4/);assert.match(bytes.toString(),/Synthetic sample document/);
+ const xref=Number(bytes.toString().match(/startxref\n(\d+)/)[1]);assert.equal(bytes.subarray(xref,xref+4).toString(),'xref');
+ for(const unknown of ['/pdf-file/'+Buffer.from('https://archive.org/download/real-book/book.pdf').toString('base64url'),'/pdf-file/invalid','/academy/open-library/catalogue/private','https://archive.org/download/academy-ui-preview-synthetic/sample-learning-guide.pdf'])assert.equal(libraryPreviewResponse(unknown),null,'Unknown resources never start a proxy or fetch');
+});
+
+test('synthetic document supports bounded range/HEAD reads and rejects writes or invalid ranges',async()=>{
+ const partial=libraryPreviewResponse(samplePdfPath,{range:'bytes=0-7'});
+ assert.equal(partial.status,206);assert.equal(await partial.text(),'%PDF-1.4');assert.match(partial.headers.get('Content-Range'),/^bytes 0-7\/\d+$/);
+ const head=libraryPreviewResponse(samplePdfPath,{method:'HEAD'});assert.equal(await head.text(),'');assert(Number(head.headers.get('Content-Length'))>0);
+ for(const range of ['bytes=99999-','bytes=9-1','bytes=0-1,4-5','invalid'])assert.equal(libraryPreviewResponse(samplePdfPath,{range}).status,416);
+ assert.equal(libraryPreviewResponse(samplePdfPath,{method:'POST'}).status,405);
+});
