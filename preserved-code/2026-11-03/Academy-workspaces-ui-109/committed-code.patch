diff --git a/backend/tools/workspace-ui-preview/library.mjs b/backend/tools/workspace-ui-preview/library.mjs
new file mode 100644
index 00000000..87c57bca
--- /dev/null
+++ b/backend/tools/workspace-ui-preview/library.mjs
@@ -0,0 +1,33 @@
+// Local review only. These two resources are synthetic, not Archive content.
+// Use the reader's existing Archive URL validation without fetching that URL.
+const sampleUrl='https://archive.org/download/academy-ui-preview-synthetic/sample-learning-guide.pdf';
+export const samplePdfPath='/pdf-file/'+Buffer.from(sampleUrl).toString('base64url');
+export const sampleLibraryBooks=[
+ {id:'workspace-preview-guide',title:'Sample learning guide',subject:'Offline review',source:'Synthetic sample',details:'Local preview',description:'A sample document for reviewing the Library and reader.',resourceType:'EBOOK',pdfUrl:sampleUrl},
+ {id:'workspace-preview-planner',title:'Sample study planner',subject:'Offline review',source:'Synthetic sample',details:'Local preview',description:'A sample printable for reviewing the Library filters.',resourceType:'PRINTABLE',pdfUrl:sampleUrl}
+];
+
+function samplePdf(){
+ const stream='BT /F1 24 Tf 60 740 Td (Offline Library review) Tj 0 -48 Td /F1 14 Tf (Synthetic sample document.) Tj 0 -26 Td (No Academy teaching material is included.) Tj ET';
+ const objects=['<< /Type /Catalog /Pages 2 0 R >>','<< /Type /Pages /Kids [3 0 R] /Count 1 >>','<< /Type /Page /Parent 2 0 R /MediaBox [0 0 595 842] /Resources << /Font << /F1 4 0 R >> >> /Contents 5 0 R >>','<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica >>',`<< /Length ${Buffer.byteLength(stream)} >>\nstream\n${stream}\nendstream`];
+ let pdf='%PDF-1.4\n';const offsets=[0];
+ for(const [i,object] of objects.entries()){offsets.push(Buffer.byteLength(pdf));pdf+=`${i+1} 0 obj\n${object}\nendobj\n`;}
+ const xref=Buffer.byteLength(pdf);pdf+='xref\n0 6\n0000000000 65535 f \n'+offsets.slice(1).map(offset=>String(offset).padStart(10,'0')+' 00000 n \n').join('');
+ return Buffer.from(pdf+`trailer\n<< /Size 6 /Root 1 0 R >>\nstartxref\n${xref}\n%%EOF\n`);
+}
+const pdfBytes=samplePdf();
+
+export function libraryPreviewResponse(pathname,{method='GET',range=null}={}){
+ if(pathname!=='/academy/open-library/catalogue'&&pathname!==samplePdfPath)return null;
+ if(!['GET','HEAD'].includes(method))return new Response(null,{status:405,headers:{Allow:'GET, HEAD'}});
+ if(pathname==='/academy/open-library/catalogue')return new Response(method==='HEAD'?null:JSON.stringify({books:sampleLibraryBooks}),{headers:{'Content-Type':'application/json','Cache-Control':'no-store'}});
+ const headers={'Content-Type':'application/pdf','Cache-Control':'no-store','Accept-Ranges':'bytes'};
+ let start=0,end=pdfBytes.length-1,status=200;
+ if(range){
+  const match=/^bytes=(\d+)-(\d*)$/.exec(range);
+  if(!match||!Number.isSafeInteger(start=Number(match[1]))||!Number.isSafeInteger(end=match[2]?Number(match[2]):end)||start>end||start>=pdfBytes.length)return new Response(null,{status:416,headers:{...headers,'Content-Range':'bytes */'+pdfBytes.length}});
+  end=Math.min(end,pdfBytes.length-1);status=206;headers['Content-Range']=`bytes ${start}-${end}/${pdfBytes.length}`;
+ }
+ headers['Content-Length']=String(end-start+1);
+ return new Response(method==='HEAD'?null:pdfBytes.subarray(start,end+1),{status,headers});
+}
