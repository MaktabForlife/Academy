+// Serve the actual Academy application with disposable local accounts/storage.
+// This harness is never included in the deployed frontend.
+import {createServer} from 'node:http';
+import {readFile,stat} from 'node:fs/promises';
+import {readFileSync} from 'node:fs';
+import {resolve,extname} from 'node:path';
+import {fileURLToPath} from 'node:url';
+import {classNotesFixture,seedClassNotes} from '../tests/fixtures/academy-class-notes-fixture.mjs';
+import academy from '../src/academy-runtime.js';
+
+const root=resolve(fileURLToPath(new URL('../..',import.meta.url)));
+const port=Number(process.env.ACADEMY_TEACH_PREVIEW_PORT||8890),origin='http://127.0.0.1:'+port;
+if(!Number.isInteger(port)||port<1024||port>65535)throw Error('Invalid local port');
+// No route in this fixture may reach the hosted Academy or external services.
+globalThis.fetch=async()=>{throw Error('External requests disabled in the local Teach review');};
+const fixture=await classNotesFixture(f=>{
+ seedClassNotes(f);
+ f.db.prepare("INSERT INTO class_teacher_assignments VALUES(?,'class-1',?,'ADDITIONAL')").run(f.scopes.programA,f.actors.teacherA);
+ f.db.prepare("INSERT INTO class_memberships VALUES(?,'teach-layout-learner','class-1',?,'2026-01-01',NULL,1)").run(f.scopes.programA,f.actors.studentA);
+ const row=f.db.prepare('SELECT * FROM timetable_publications WHERE activity_key=? ORDER BY version_no DESC LIMIT 1').get(f.scopes.programA),snapshot=JSON.parse(row.snapshot_json);
+ for(const rule of snapshot.rules){rule.teacherId=f.actors.teacherA;rule.teacherIds=[f.actors.teacherA];rule.teacherName='Synthetic teacherA';rule.teacherNames=['Synthetic teacherA'];}
+ const next={...row,publication_id:'teach-layout-sample',version_no:row.version_no+1,snapshot_json:JSON.stringify(snapshot)},columns=Object.keys(next);
+ f.db.prepare('INSERT INTO timetable_publications('+columns.join(',')+') VALUES('+columns.map(()=>'?').join(',')+')').run(...Object.values(next));
+ f.db.prepare('UPDATE program_publication_state SET latest_publication_id=? WHERE activity_key=?').run(next.publication_id,f.scopes.programA);
+ // Satisfy the existing public registry prerequisite in the disposable fixture.
+ const reboot='PRG-46c8576d-9fcf-4000-96b9-856b00a0218a',scope='PROGRAM:'+reboot;
+ f.db.prepare("INSERT INTO activities(activity_key,activity_id,kind,name,active,lifecycle,website_visible) VALUES(?,?,'PROGRAM','Reboot',1,'ACTIVE',0)").run(scope,reboot);
+ f.db.prepare("INSERT INTO program_settings(activity_key,timezone) VALUES(?,'Africa/Johannesburg')").run(scope);
+ f.db.prepare("INSERT INTO data_ownership(dataset_key,scope_key,authoritative_store,phase,revision) VALUES('ACADEMY',?,'SHEETS','STAGING',1)").run(scope);
+});
+for(const name of ['0037_session_mp4.sql','0038_messaging.sql']){fixture.db.exec('BEGIN');fixture.db.exec(readFileSync(new URL('../migrations/academy/'+name,import.meta.url),'utf8'));fixture.db.exec('COMMIT');}
+fixture.env.ACADEMY_MESSAGING='1';fixture.env.ALLOWED_ORIGINS=origin;
+const types={'.html':'text/html; charset=utf-8','.css':'text/css','.js':'text/javascript','.mjs':'text/javascript','.json':'application/json','.png':'image/png','.jpg':'image/jpeg','.webp':'image/webp','.svg':'image/svg+xml','.ico':'image/x-icon','.woff2':'font/woff2'};
+const files=new Set(['/version.json','/ummabbadacademy.png','/academy.png','/logo.png']);
+const paths=/^\/(?:academy|account|js|css|fonts|images|icons|recorder)\//;
+const server=createServer(async(req,res)=>{
+ res.setHeader('Cache-Control','no-store');res.setHeader('X-Robots-Tag','noindex, nofollow');res.setHeader('X-Content-Type-Options','nosniff');
+ res.setHeader('Content-Security-Policy',"connect-src 'self'; form-action 'self'; base-uri 'self'; object-src 'none'; frame-src 'self'");
+ try{
+  if(req.headers.host!=='127.0.0.1:'+port||req.headers.origin&&req.headers.origin!==origin){res.writeHead(403).end();return;}
+  const url=new URL(req.url,origin);
+  if(url.pathname.startsWith('/api/')){
+   if(url.pathname==='/api/academy/header-date'){res.setHeader('Content-Type','application/json');res.end(JSON.stringify({gregorian:fixture.today,hijri:'Local date preview'}));return;}
+   if(!['GET','HEAD','POST'].includes(req.method)){res.writeHead(405).end();return;}
+   let size=0;const chunks=[];for await(const chunk of req){size+=chunk.length;if(size>1024*1024){res.writeHead(413).end();return;}chunks.push(chunk);}
+   const response=await academy.fetch(new Request(url,{method:req.method,headers:req.headers,...(['GET','HEAD'].includes(req.method)?{}:{body:Buffer.concat(chunks)})}),fixture.env);
+   res.writeHead(response.status,Object.fromEntries(response.headers));res.end(Buffer.from(await response.arrayBuffer()));return;
+  }
+  if(!['GET','HEAD'].includes(req.method)){res.writeHead(405).end();return;}
+  if(url.pathname==='/'){res.writeHead(302,{Location:'/academy/#timetable/teach'}).end();return;}
+  if(url.pathname==='/js/m4l-config.js'){
+   res.setHeader('Content-Type','text/javascript');res.end('window.M4L_CONFIG=Object.freeze({API_BASE:location.origin,ENV_NAME:"local-teach-review",IS_DEVELOPMENT:true,IS_PRODUCTION:false,ACCEPTED_SETUP:true,NATIVE_ATTENDANCE:true,MEDIA_SEPARATION:true,LEARNING_OPERATIONS:3});');return;
+  }
+  const pathname=decodeURIComponent(url.pathname);
+  if(pathname.split('/').some(part=>part.startsWith('.'))||!paths.test(pathname)&&!files.has(pathname)){res.writeHead(404).end();return;}
+  let path=resolve(root,'.'+pathname);if(!path.startsWith(root+'/')){res.writeHead(404).end();return;}
+  if((await stat(path)).isDirectory())path+='/index.html';
+  if(!types[extname(path)]){res.writeHead(404).end();return;}
+  res.setHeader('Content-Type',types[extname(path)]);res.end(req.method==='HEAD'?undefined:await readFile(path));
+ }catch(error){res.writeHead(error.code==='ENOENT'?404:500,{'Content-Type':'application/json'});res.end(JSON.stringify({success:false,error:error.code==='ENOENT'?'Not found':'Local fixture request failed'}));}
+});
+await new Promise((done,reject)=>{server.once('error',reject);server.listen(port,'127.0.0.1',done);});
+console.log('Teach development review: '+origin+'/academy/#timetable/teach');
+console.log('Disposable sample login: separation-teacherA / 1234. Admin: separation-global / 1234.');
+console.log('Only local synthetic data; no hosted API, real accounts or shared storage.');
+await new Promise(done=>{process.once('SIGINT',done);process.once('SIGTERM',done);});
+await new Promise(done=>server.close(done));fixture.close();
