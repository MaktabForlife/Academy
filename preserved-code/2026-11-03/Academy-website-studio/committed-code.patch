+     const a=assets.get(id),resolved=a.kind==='PDF'?lessonPdfObjectKey(a.object_key):a.object_key;
+     const shared=a.kind==='PDF'?resolved?.match(/\/sha256\/([a-f0-9]{64})\.pdf$/)?.[1]:null;
+     const retained=a.kind==='MP4'&&Boolean(a.object_key?.startsWith(objectNamespace+'retained-program-recordings/'+encodeURIComponent(source.activity_key)+'/'));
+     const expiry=a.kind==='MP4'&&!retained?Date.parse(a.created_at)+14*86400_000:null;
+     return {sourceAssetId:id,kind:a.kind,name:a.display_name||a.filename||'Recording',filename:a.filename||'',byteSize:a.byte_size??null,
+      youtubeId:a.youtube_id||null,sourceObjectKey:a.object_key||null,resolvedObjectKey:resolved||null,expectedSha256:shared||null,
+      linked:linked.has(JSON.stringify([l.lesson_id,id])),createdAt:a.created_at,
