+const query=`SELECT h.head_id,w.version write_version,s.activity_key,s.revision generation,s.enabled,m.offering_id,m.kind,
+ s.purchase_model,c.legacy_access_model,c.policy_review_state,p.enabled monthly_enabled,a.active,a.lifecycle
+ FROM setup_head_state h CROSS JOIN academy_write_state w
+ JOIN website_platform_access_scopes s ON s.activity_key=?
+ JOIN website_platform_timetable_scopes m USING(activity_key) JOIN activities a USING(activity_key)
+ LEFT JOIN course_settings c USING(activity_key) LEFT JOIN program_monthly_media_policies p USING(activity_key)
+ WHERE h.singleton=1 AND w.singleton=1`;
+const stamp=row=>JSON.stringify(row);
+
+export async function openMediaInventory(db,{activityKey,checkpoint=null,now=Date.now(),objectNamespace=''}={}){
+ identifier(activityKey);
