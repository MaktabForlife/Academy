+  const page={format:'ACADEMY_MEDIA_INVENTORY_V1',inventoryId,source:origin,lessons:result,more,checkpoint:{inventoryId,afterLessonId:last}};
+  if(new TextEncoder().encode(JSON.stringify(page)).length>240_000)throw Error('MEDIA_PAGE_TOO_LARGE');return page;
+ }};
+}
