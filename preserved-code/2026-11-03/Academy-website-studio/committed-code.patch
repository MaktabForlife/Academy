+ const source=await db.prepare(query).bind(activityKey).first();
+ if(!source||!source.enabled||!source.active||source.lifecycle!=='ACTIVE'||
+   !(source.kind==='TAFSEER'&&source.monthly_enabled===1||source.kind==='COURSE'&&source.purchase_model==='CONFIRMED_SUBSCRIPTION'&&source.legacy_access_model==='PAID'&&source.policy_review_state==='CONFIRMED'))throw Error('MEDIA_SCOPE_NOT_REVIEWED');
+ const components=await all(db,`SELECT v.table_name,c.component_id,c.digest,c.row_count,c.rows_json
+  FROM setup_head_components v JOIN setup_components c USING(component_id)
