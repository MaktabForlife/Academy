+ const origin={activityKey:source.activity_key,offeringId:source.offering_id,kind:source.kind,headId:source.head_id,generation:source.generation,writeVersion:source.write_version,components:componentRefs};
+ const inventoryId=await sha256(JSON.stringify(origin));
+ if(checkpoint&&(checkpoint.inventoryId!==inventoryId||typeof checkpoint.afterLessonId!=='string'||checkpoint.afterLessonId&&!seen.has(checkpoint.afterLessonId)))throw Error('MEDIA_CHECKPOINT_CHANGED');
+ const assertCurrent=async()=>{if(stamp(await db.prepare(query).bind(activityKey).first())!==stamp(source))throw Error('MEDIA_SOURCE_CHANGED');};
+ await assertCurrent();
+ return {inventoryId,source:origin,totalLessons:lessons.length,async page({after=checkpoint?.afterLessonId||'',limit=25}={}){
+  if(!Number.isInteger(limit)||limit<1||limit>25||after&&!seen.has(after))throw Error('MEDIA_PAGE_INVALID');
+  await assertCurrent();const selected=lessons.filter(l=>l.lesson_id>after).slice(0,limit),ids=JSON.stringify(selected.map(l=>l.lesson_id));
+  const live=await all(db,'SELECT lesson_id,state FROM lesson_media_lessons WHERE lesson_id IN(SELECT value FROM json_each(?))',ids),states=new Map(live.map(r=>[r.lesson_id,r.state]));
+  const visible=await all(db,'SELECT lesson_id,visible FROM lesson_media_visibility WHERE lesson_id IN(SELECT value FROM json_each(?))',ids),hidden=new Set(visible.filter(r=>!r.visible).map(r=>r.lesson_id));
+  const currentLinks=bounded(await all(db,'SELECT lesson_id,asset_id FROM lesson_media_links WHERE lesson_id IN(SELECT value FROM json_each(?)) LIMIT 501',ids),500,'live links'),linked=new Set(currentLinks.map(r=>JSON.stringify([r.lesson_id,r.asset_id])));
