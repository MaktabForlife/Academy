+ for(const row of lessons){identifier(row.lesson_id);if(seen.has(row.lesson_id)||row.activity_key?.toLowerCase()!==source.activity_key.toLowerCase())throw Error('MEDIA_COMPONENT_SCOPE');seen.add(row.lesson_id);}
+ for(const row of records.lesson_media_links){identifier(row.asset_id);identifier(row.lesson_id);if(!seen.has(row.lesson_id)||!assets.has(row.asset_id))throw Error('MEDIA_COMPONENT_REFERENCE');const list=links.get(row.lesson_id)||[];if(list.includes(row.asset_id))throw Error('MEDIA_COMPONENT_DUPLICATE');list.push(row.asset_id);links.set(row.lesson_id,bounded(list,20,'lesson assets'));}
