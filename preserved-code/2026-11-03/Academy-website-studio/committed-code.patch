+   // Match Academy monthlyAudienceSQL exactly: saved class plus the first
+   // original session's classIds. Never substitute today's class allocation.
+   const original=JSON.parse(l.source_lessons_json||'[]');if(!Array.isArray(original)||original[0]?.classIds!==undefined&&!Array.isArray(original[0].classIds))throw Error('MEDIA_SESSION_SOURCE_INVALID');
+   const cohorts=[...new Set([l.class_id,...(original[0]?.classIds||[])].filter(Boolean))];bounded(cohorts,100,'cohorts');cohorts.forEach(identifier);
+   const state=!states.has(l.lesson_id)?'MISSING':states.get(l.lesson_id)==='HIDDEN'||hidden.has(l.lesson_id)?'HIDDEN':l.state;
+   return {sourceLessonId:l.lesson_id,sessionKey:l.session_key||null,runId:l.run_id||'',publicationId:l.source_publication_id||null,
+    scope:l.media_scope||'SESSION',date:l.lesson_date,title:l.title,revision:l.revision,state,cohorts,
