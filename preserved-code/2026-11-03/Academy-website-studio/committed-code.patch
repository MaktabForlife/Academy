+// Accepts an already available private local SQLite snapshot; never contacts D1.
+import {DatabaseSync} from 'node:sqlite';
+import {mkdir,writeFile} from 'node:fs/promises';
+import {resolve} from 'node:path';
+import {sqliteD1} from './academy-split/sqlite-d1.mjs';
+import {openMediaInventory} from './website-media-inventory.mjs';
+
+const [snapshot,activityKey,destination,...extra]=process.argv.slice(2);
+if(!snapshot||!activityKey||!destination||extra.length)throw Error('Usage: node tools/website-media-inventory-local.mjs PRIVATE_SQLITE ACTIVITY_KEY NEW_PRIVATE_OUTPUT_DIRECTORY');
+const directory=resolve(destination),db=new DatabaseSync(resolve(snapshot),{readOnly:true});
+try{
+ if(!directory.startsWith('/private/tmp/academy-media-'))throw Error('Use a new private /private/tmp/academy-media-… directory.');
+ await mkdir(directory,{mode:0o700});
+ const inventory=await openMediaInventory(sqliteD1(db),{activityKey,objectNamespace:process.env.ACADEMY_OBJECT_NAMESPACE||''});
+ let after='',pageNo=0;
+ do{const page=await inventory.page({after});await writeFile(resolve(directory,'page-'+String(++pageNo).padStart(4,'0')+'.json'),JSON.stringify(page,null,2),{mode:0o600,flag:'wx'});after=page.checkpoint.afterLessonId;if(!page.more)break;}while(true);
+ await writeFile(resolve(directory,'summary.json'),JSON.stringify({inventoryId:inventory.inventoryId,lessons:inventory.totalLessons,pages:pageNo,bytesCopied:false,published:false},null,2),{mode:0o600,flag:'wx'});
+ console.log(JSON.stringify({lessons:inventory.totalLessons,pages:pageNo,bytesCopied:false,published:false}));
+}finally{db.close();}
