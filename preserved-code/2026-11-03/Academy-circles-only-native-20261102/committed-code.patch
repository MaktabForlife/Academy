diff --git a/css/m4l-circles-native.css b/css/m4l-circles-native.css
new file mode 100644
index 00000000..43fdfb14
--- /dev/null
+++ b/css/m4l-circles-native.css
@@ -0,0 +1,24 @@
+#academy-startup{display:none;padding:clamp(22px,4vw,48px);border:1px solid var(--line);border-radius:20px;background:var(--paper);margin:10px 0 24px}
+.academy-opening #academy-startup{display:block}
+.academy-opening .container>.view{display:none!important}
+.academy-opening:not(.academy-opening-failed) #entrance-status{display:none}
+.academy-opening #academy-login{visibility:hidden}
+.academy-opening-programme #academy-startup{position:fixed;inset:0;z-index:10000;margin:0;border:0;border-radius:0;display:flex;flex-direction:column;justify-content:center;align-items:center;min-height:100dvh;background:var(--bg,#f8f5ef);font-family:Arial,Helvetica,sans-serif;overflow:auto}
+.academy-opening-programme:not(.academy-opening-failed) #academy-startup .academy-startup-cards{width:min(700px,100%)}
+.academy-startup-heading{display:flex;align-items:center;gap:14px}
+.academy-startup-heading h1{font:600 clamp(22px,3vw,32px)/1.25 Arial,sans-serif;margin:0;color:var(--rose-dark)}
+#academy-startup p{color:var(--muted);margin:14px 0 24px}
+.academy-startup-spinner{width:26px;height:26px;flex:none;border:3px solid var(--rose-soft);border-top-color:var(--rose);border-radius:50%;animation:academy-startup-spin .9s linear infinite}
+.academy-startup-cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}
+.academy-startup-cards>div{height:150px;border:1px solid var(--line);border-radius:14px;background:linear-gradient(110deg,var(--rose-soft) 20%,var(--paper) 45%,var(--rose-soft) 70%);background-size:250% 100%;animation:academy-startup-glow 1.8s ease-in-out infinite}
+.academy-opening-failed .academy-startup-spinner,.academy-opening-failed .academy-startup-cards{display:none}
+.academy-opening-failed #academy-startup>p:not(#academy-startup-error){display:none}
+#academy-startup-error,#academy-startup-retry{display:none}
+.academy-opening-failed #academy-startup-error,.academy-opening-failed #academy-startup-retry{display:block}
+#academy-startup-error{max-width:42rem;text-align:center;overflow-wrap:anywhere}
+#academy-session-loading{margin:12px 0 24px;color:var(--muted)}
+@keyframes academy-startup-spin{to{transform:rotate(360deg)}}
+@keyframes academy-startup-glow{to{background-position:100% 0}}
+@media(max-width:600px){.academy-startup-cards{grid-template-columns:1fr}.academy-startup-cards>div{height:85px}}
+@media(prefers-reduced-motion:reduce){.academy-startup-spinner,.academy-startup-cards>div{animation:none}}
+.circles-recovery{max-width:50rem;margin:24px auto;padding:24px}.circles-recovery .workspace-actions{display:flex;gap:12px;flex-wrap:wrap}
