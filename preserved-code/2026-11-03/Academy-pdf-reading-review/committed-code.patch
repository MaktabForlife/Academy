diff --git a/tools/pdf-reading-review/local-draft.mjs b/tools/pdf-reading-review/local-draft.mjs
new file mode 100644
index 00000000..e548681a
--- /dev/null
+++ b/tools/pdf-reading-review/local-draft.mjs
@@ -0,0 +1,40 @@
+// Local review fixture only. The connected platform owns R2/history/permissions.
+import {validateCourse} from '../../academy/course-websites/model.mjs';
+// Add a reviewed edition without overwriting a person's earlier device edits.
+export function mergeReviewDraft(previous,edited,current){
+ const same=(a,b)=>JSON.stringify(a)===JSON.stringify(b);
+ if(same(previous,edited))return structuredClone(current);
+ if(Array.isArray(previous)&&Array.isArray(edited)&&Array.isArray(current)&&[...previous,...edited,...current].every(v=>v&&typeof v==='object'&&typeof v.id==='string')){
+  const old=new Map(previous.map(v=>[v.id,v])),next=new Map(current.map(v=>[v.id,v]));
+  const merged=edited.map(v=>next.has(v.id)?mergeReviewDraft(old.get(v.id),v,next.get(v.id)):structuredClone(v));
+  for(let i=0;i<current.length;i++){const item=current[i];if(old.has(item.id)||merged.some(v=>v.id===item.id))continue;const following=current.slice(i+1).map(v=>v.id),at=merged.findIndex(v=>following.includes(v.id));merged.splice(at<0?merged.length:at,0,structuredClone(item));}
+  return merged;
+ }
+ if(edited&&current&&typeof edited==='object'&&typeof current==='object'&&!Array.isArray(edited)&&!Array.isArray(current)){
+  const result=structuredClone(edited);for(const [key,value] of Object.entries(current)){const merged=mergeReviewDraft(previous?.[key],edited[key],value);if(merged!==undefined)result[key]=merged;else delete result[key];}return result;
+ }
+ return structuredClone(edited);
+}
+export function localDraft(original,storage=localStorage,{previousOriginal,baselineVersion}={}){
+ const key='academy-pdf-builder-review:'+original.id;
+ let revision=0;
+ function read(){
+  const raw=storage.getItem(key);if(!raw)return {document:structuredClone(original),revision:0};
+  const value=JSON.parse(raw),record=value.document?value:{document:value,revision:0};
+  if(record.document.id!==original.id||!Number.isSafeInteger(record.revision))throw Error('The local draft does not match this website.');
+  validateCourse(record.document);
+  if(previousOriginal&&baselineVersion&&record.baselineVersion!==baselineVersion){record.document=mergeReviewDraft(previousOriginal,record.document,original);validateCourse(record.document);record.needsReviewMerge=true;}
+  return record;
+ }
+ return {
+  open(){const r=read();revision=r.revision;return structuredClone(r);},
+  save(document){
+   validateCourse(document);
+   if(document.id!==original.id)throw Error('Save belongs to a different website.');
+   if(read().revision!==revision)throw Error('This draft changed in another editor. Your unsaved text is still here. Save a copy before reopening it.');
+   const r={document:structuredClone(document),revision:revision+1,...(baselineVersion?{baselineVersion}:{})};
+   storage.setItem(key,JSON.stringify(r));revision=r.revision;return structuredClone(r);
+  },
+  get revision(){return revision;}
+ };
+}
