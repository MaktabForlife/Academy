+ if(editing){if(dirty&&!confirm('Leave these unsaved local edits? Use Save draft to keep them first.'))return;course=published;editing=false;dirty=false;document.querySelector('#edit-text').textContent='Edit text';document.querySelector('#save-text').hidden=true;document.querySelector('#student-preview').disabled=false;document.querySelector('#preview-description').textContent='Author preview · original review edition. Notes stay in this tab.';}
