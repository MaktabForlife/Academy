+// Content references and device-preview watch accounting; no identity or network.
+export function seconds(value){
+ if(typeof value==='number')return Number.isFinite(value)&&value>=0?value:null;
+ if(typeof value!=='string')return null;
+ if(/^\d+(?:\.\d+)?s?$/.test(value))return Number(value.replace(/s$/,''));
+ if(/^\d{1,3}:\d{2}(?::\d{2})?$/.test(value)){const p=value.split(':').map(Number);if(p.slice(1).some(n=>n>59))return null;return p.reduce((a,n)=>a*60+n,0);}
+ if(/^(?:\d+h)?(?:\d+m)?(?:\d+s)?$/.test(value)&&value){return [...value.matchAll(/(\d+)([hms])/g)].reduce((n,m)=>n+Number(m[1])*({h:3600,m:60,s:1}[m[2]]),0);}
+ return null;
+}
+export function timeLabel(n){n=Math.max(0,Math.floor(Number(n)||0));return (n>=3600?Math.floor(n/3600)+':':'')+String(Math.floor(n/60)%60).padStart(n>=3600?2:1,'0')+':'+String(n%60).padStart(2,'0');}
+export function youtubeSource(value){
+ try{const u=new URL(value);if(u.protocol!=='https:'||u.username||u.password||u.port)return null;
+  const host=u.hostname.toLowerCase();let id='';
+  if(host==='youtu.be')id=u.pathname.slice(1);
+  else if(['www.youtube.com','youtube.com','www.youtube-nocookie.com'].includes(host)){if(u.pathname==='/watch')id=u.searchParams.get('v');else if(/^\/(embed|shorts|live)\//.test(u.pathname))id=u.pathname.split('/')[2];}
+  if(!/^[A-Za-z0-9_-]{11}$/.test(id||''))return null;
+  const start=seconds(u.searchParams.get('t')||u.searchParams.get('start')||'0');if(start===null||start>604800)return null;
+  return {id,start,url:'https://www.youtube.com/watch?v='+id+(start?'&t='+Math.floor(start)+'s':'')};
+ }catch{return null;}
+}
+export function chapter(value){const m=typeof value==='string'&&value.match(/^(\d{1,3}:\d{2}(?::\d{2})?)\s+(.+)$/);if(!m)return null;const start=seconds(m[1]);return start===null?null:{start,title:m[2].trim(),stamp:m[1]};}
+export function courseRecordings(course){const found=new Map();for(const l of course.lessons)for(const s of l.sections)for(const b of s.blocks)if(b.type==='video'){const v=youtubeSource(b.videoUrl);if(v&&!found.has(v.id))found.set(v.id,{...v,title:b.text,summary:l.summary,quote:l.sections.flatMap(s=>s.blocks).find(b=>b.type==='quote'&&b.videoUrl&&!b.reference),duration:b.durationSeconds,blockId:b.id,lessonId:l.id});}return [...found.values()];}
+export function mergeIntervals(ranges,duration){const result=[];for(const item of ranges.filter(r=>Array.isArray(r)&&r.length===2&&r.every(Number.isFinite)&&r[0]>=0&&r[1]>r[0]).map(([a,b])=>[Math.min(a,duration),Math.min(b,duration)]).filter(([a,b])=>b>a).sort((a,b)=>a[0]-b[0])){const last=result.at(-1);if(last&&item[0]<=last[1])last[1]=Math.max(last[1],item[1]);else result.push([...item]);}return result;}
+export function watchedSeconds(record){return (record?.ranges||[]).reduce((n,[a,b])=>n+b-a,0);}
+export function watchLedger(){
+ const records=new Map();let sample=null;
+ return {
+  get(id){return records.get(id)||{ranges:[],lastPosition:0,duration:0};},
+  sample({id,position,duration,playing,clock,rate=1}){
+   if(!/^[A-Za-z0-9_-]{11}$/.test(id)||![position,duration,clock,rate].every(Number.isFinite)||duration<=0||position<0||position>duration+1||rate<=0||typeof playing!=='boolean')return false;
+   const record=records.get(id)||{ranges:[],lastPosition:0,duration};record.duration=duration;record.lastPosition=Math.min(position,duration);
+   if(sample?.id===id&&sample.playing){const elapsed=(clock-sample.clock)/1000,delta=position-sample.position;if(elapsed>0&&elapsed<=12&&delta>0&&delta<=elapsed*Math.max(rate,sample.rate)+1.25){record.ranges=mergeIntervals([...record.ranges,[sample.position,position]],duration);}}
+   records.set(id,record);sample={id,position,playing,clock,rate};return true;
+  },
+  stop(){sample=null;},
+  export(){return Object.fromEntries([...records].map(([id,v])=>[id,{...v,ranges:v.ranges.map(r=>[...r])}]));},
+  restore(value,allowed){sample=null;records.clear();for(const [id,v] of Object.entries(value||{})){const duration=allowed.get(id);if(!duration||!v||!Array.isArray(v.ranges)||!Number.isFinite(v.lastPosition))continue;const ranges=mergeIntervals(v.ranges.slice(0,10000),duration);records.set(id,{duration,lastPosition:Math.min(duration,Math.max(0,v.lastPosition)),ranges});}},
