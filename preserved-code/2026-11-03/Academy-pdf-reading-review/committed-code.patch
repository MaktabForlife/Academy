+function videoPoster(v,title,lessonId=''){return `<a class="sp-video-poster" href="${esc(v.url)}" target="_blank" rel="noopener noreferrer" data-sp="play-video" data-video="${v.id}" data-start="${v.start}"${lessonId?` data-lesson-id="${esc(lessonId)}"`:''} aria-label="Watch ${esc(title)}"><img src="https://i.ytimg.com/vi/${v.id}/hqdefault.jpg" alt="" loading="lazy" referrerpolicy="no-referrer"><span class="sp-video-poster-play" aria-hidden="true">▶</span><span class="sp-video-poster-label">Watch & follow along</span></a>`;}
+export function recordingNavigation(course,lesson){
+ if(!course.recordingCompanion)return '';
+ const recordings=courseRecordings(course),source=lesson.sections.flatMap(s=>s.blocks).filter(b=>b.type==='video'&&!b.topicsOnly).map(b=>youtubeSource(b.videoUrl)).find(Boolean),recording=recordings.find(v=>v.id===source?.id)||(lesson.companionReading&&recordings.length===1?recordings[0]:null);
+ if(!recording)return '';
+ if(lesson.companionReading)return `<button class="sp-back-to-recording" data-sp="lesson" data-id="${esc(recording.lessonId)}">← Recorded lesson</button>`;
+ const notes=course.lessons.filter(l=>l.companionReading).map(l=>{const video=l.sections.flatMap(s=>s.blocks).filter(b=>b.type==='video'&&!b.topicsOnly).map(b=>youtubeSource(b.videoUrl)).find(v=>v?.id===recording.id);return video?{lesson:l,video}:null;}).filter(Boolean);
+ if(!notes.length)return '';
