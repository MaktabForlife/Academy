+}
+export function quoteRecordingLink(b){const v=youtubeSource(b.videoUrl);return v?`<a class="sp-quote-recording" href="${esc(v.url)}" target="_blank" rel="noopener noreferrer" data-sp="play-video" data-video="${v.id}" data-start="${v.start}">Hear this in the recording ↗</a>`:'';}
