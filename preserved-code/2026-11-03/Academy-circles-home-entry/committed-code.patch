diff --git a/academy/website-platform/connect/entry-destination.mjs b/academy/website-platform/connect/entry-destination.mjs
new file mode 100644
index 00000000..7e5a86ef
--- /dev/null
+++ b/academy/website-platform/connect/entry-destination.mjs
@@ -0,0 +1,9 @@
+// Navigation only. Academy still resolves the signed-in account's programme
+// permissions and its existing per-account HifzHelper link.
+export function academyEntryDestination(destination,config={}){
+ if(destination!=='hifz')return '/academy/';
+ const program=config.HIFZ_PROGRAM_ID;
+ return typeof program==='string'&&/^[-A-Za-z0-9_:]{1,180}$/.test(program)
+  ?'/academy/#activity/PROGRAM/'+encodeURIComponent(program)+'/learn'
+  :'/academy/#hifz';
+}
diff --git a/backend/tests/website-entry-destination.test.mjs b/backend/tests/website-entry-destination.test.mjs
new file mode 100644
