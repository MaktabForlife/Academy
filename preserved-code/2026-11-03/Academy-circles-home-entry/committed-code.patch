--- /dev/null
+++ b/backend/tests/website-entry-destination.test.mjs
@@ -0,0 +1,11 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {academyEntryDestination} from '../../academy/website-platform/connect/entry-destination.mjs';
+
+test('the verified website handoff offers only native Academy and Hifz destinations',()=>{
+ assert.equal(academyEntryDestination('academy'),'/academy/');
+ assert.equal(academyEntryDestination('hifz',{HIFZ_PROGRAM_ID:'synthetic-hifz'}),'/academy/#activity/PROGRAM/synthetic-hifz/learn');
+ assert.equal(academyEntryDestination('hifz'),'/academy/#hifz');
+ for(const destination of [undefined,'https://outside.test','//outside.test','/academy/admin/'])assert.equal(academyEntryDestination(destination),'/academy/');
+ for(const HIFZ_PROGRAM_ID of ['../outside','https://outside.test','bad#fragment','x'.repeat(181)])assert.equal(academyEntryDestination('hifz',{HIFZ_PROGRAM_ID}),'/academy/#hifz');
+});
